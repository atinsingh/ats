# Multi-stage build for Spring Boot services.
# Build from repository root after generating `./gradlew` (`gradle wrapper`).
#
# Example:
# docker build -f infra/docker/Dockerfile.java-service \
#   --build-arg GRADLE_TASK=:services-java:job-service:bootJar \
#   --build-arg SERVICE_DIR=services-java/job-service \
#   -t jobocate/job-service:local .

FROM eclipse-temurin:21-jdk AS builder
WORKDIR /workspace
COPY . .
ARG GRADLE_TASK=:services-java:job-service:bootJar
RUN test -x ./gradlew || (echo "Missing ./gradlew. Run: gradle wrapper" && exit 1)
RUN ./gradlew "$GRADLE_TASK" --no-daemon -x test

FROM eclipse-temurin:21-jre
WORKDIR /app
ARG SERVICE_DIR=services-java/job-service
COPY --from=builder /workspace/${SERVICE_DIR}/build/libs/*.jar /app/app.jar
EXPOSE 8080
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0"
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
