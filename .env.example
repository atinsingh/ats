# Copy to .env and adjust. Never commit real secrets.

# --- Databases ---
POSTGRES_USER=jobocate
POSTGRES_PASSWORD=jobocate_local_dev_only
POSTGRES_DB=jobocate
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobocate

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Kafka (Redpanda external listener from compose) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# --- OpenSearch ---
OPENSEARCH_URL=http://localhost:9200

# --- S3 (MinIO local) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET_RESUMES=jobocate-resumes
S3_REGION=us-east-1

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=local-dev

# --- Next.js (examples) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# job-service (Spring) — README examples use 8082 when bootRun per service
NEXT_PUBLIC_JOB_SERVICE_URL=http://localhost:8082
NEXT_PUBLIC_APP_ENV=local
AUTH_SECRET=change_me_in_dev_only_32chars_min____

# --- job-portal-web (server routes) ---
SEARCH_GATEWAY_URL=http://localhost:7070
PORTAL_SEARCH_TENANT_ID=11111111-1111-1111-1111-111111111111

# --- Auth service ---
TENANT_AUTH_ISSUER=http://localhost:8090

# --- Jobocate platform (Spring `jobocate.*` config) ---
JOBOCATE_JWT_SECRET=jobocate-local-jwt-secret-change-me!!!
JOBOCATE_ALLOW_HEADER_TENANT=true
